generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CHILD
  PARENT
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum LockStatus {
  UNLOCKED
  PAID
  DEV
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  phone            String?   @unique
  password         String
  name             String
  parentName       String?
  role             Role      @default(CHILD)
  avatar           String?
  dateOfBirth      DateTime?
  childAge         Int?
  gender           Gender?
  isPaid           Boolean   @default(false)
  isPendingPaid    Boolean   @default(false)
  isActive         Boolean   @default(true)
  paidUntil        DateTime?
  subscriptionPlanId String?
  pendingPlanId      String?

  level            Int       @default(1)
  stars            Int       @default(0)
  badges           Int       @default(0)
  lessonsCompleted Int       @default(0)
  weeklyProgress   Int       @default(0)

  refreshTokens    RefreshToken[]
  lessonProgress   LessonProgress[]
  questionResults  QuestionResult[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Zone {
  id         String     @id @default(cuid())
  name       String
  desc       String
  color      String
  img        String
  key        String     @unique // e.g. "emotion", "friendship", "communication", "independence", "situation"
  lockStatus LockStatus @default(UNLOCKED)
  lessons    Lesson[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Lesson {
  id            String         @id @default(cuid())
  title         String
  description   String         @default("")
  emoji         String
  img           String         @default("")
  level         String         @default("Cơ bản") // e.g. "Cơ bản", "Trung cấp"
  duration      String         @default("20 phút")
  stars         Int            @default(10)
  stepsCount    Int            @default(5) // number of steps in this lesson
  lockStatus    LockStatus     @default(UNLOCKED)
  zoneId        String
  zone          Zone           @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  quizQuestions QuizQuestion[]
  welcomeText    String         @default("")
  preVideoText   String         @default("")
  postVideoText  String         @default("")
  welcomeAudio   String         @default("")
  preVideoAudio     String         @default("")
  postVideoAudio    String         @default("")
  videoUrl          String         @default("")
  postQuestionText  String         @default("")
  postQuestionAudio String         @default("")
  createdAt        DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model QuizQuestion {
  id              String   @id @default(cuid())
  prompt          String
  voiceUrl        String   @default("")
  correctOptionId Int
  options         Json     // Array of: { id: number, label: string, sprite: string, style: object }
  lessonId        String
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model News {
  id          Int      @id @default(autoincrement())
  title       String
  category    String   @default("Tin tức")
  date        String
  author      String
  image       String   @default("")
  excerpt     String   @default("")
  content     String[] @default([])
  featured    Boolean  @default(false)
  fanpage_image String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoreSettings {
  id                Int      @id @default(1)
  name              String   @default("Kiddo")
  phone             String?
  currency          String   @default("VND")
  address           String?
  province          String?
  district          String?
  ward              String?
  business_type     String?
  tiktok_url        String?
  facebook_url      String?
  youtube_url       String?
  instagram_url     String?
  phone_number      String?
  gmail             String?
  social_address    String?
  footer_description String?  @default("Ottopia đồng hành cùng bé phát triển kỹ năng sống qua những trải nghiệm vui vẻ và ý nghĩa mỗi ngày.")
  footer_copyright   String?  @default("© 2026 OTTOPIA Learning. All rights reserved.")
  banner_scoreboard String?  @default("[]")
  banner_tournament String?  @default("[]")
  banner_ranking    String?
  banner_member     String?
  bank_name          String?  @default("MB Bank (Ngân hàng Quân đội)")
  bank_account_number String? @default("0842486222")
  bank_account_name   String?  @default("KIDDO LEARNING")
  bank_code          String?  @default("MB")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  price       Int
  period      String
  features    Json
  isPopular   Boolean  @default(false)
  durationMonths Int    @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LessonProgress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  status    String   @default("in-progress")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
}

model QuestionResult {
  id            String   @id @default(cuid())
  userId        String
  lessonId      String
  questionIndex Int
  isCorrect     Boolean
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, lessonId, questionIndex])
}
