# Database - PostgreSQL (Docker)
DATABASE_URL="postgresql://kiddo:kiddo_password@localhost:5432/kiddo_db"

# JWT Secrets - CHANGE THESE IN PRODUCTION!
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters-access"
JWT_REFRESH_SECRET="replace-with-at-least-32-random-characters-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development

# CORS - Frontend URL
CLIENT_URL="http://localhost:5173"

# Google Identity Services (use the same Web client ID in frontend and backend)
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Required only when running npm run db:seed
SEED_ADMIN_PASSWORD="replace-with-a-unique-admin-password"
SEED_TEST_PASSWORD="replace-with-a-unique-test-password"

# Google Analytics 4 Configuration
GA4_PROPERTY_ID=""
GA4_CLIENT_EMAIL=""
GA4_PRIVATE_KEY=""
GA4_MOCK="true"

# OpenAI (server-side only; never expose this key through a VITE_ variable)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
